{
  "name": "warsha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Warsha — a browser-only IDE for students (Java + Python)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prebuild": "npm run assets",
    "predev": "npm run assets",
    "assets": "cp ../runtimes/java/src/jvm.worker.js public/warsha-jvm.worker.js && cp node_modules/esbuild-wasm/esbuild.wasm public/warsha-esbuild.wasm && cp node_modules/@tailwindcss/browser/dist/index.global.js public/warsha-tailwind.js && ../runtimes/java/fetch-compiler.sh public && ../runtimes/csharp/build.sh public/warsha-dotnet"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/browser": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "esbuild-wasm": "^0.25.12",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.0"
  }
}

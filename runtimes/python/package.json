{
  "name": "@warsha/runtime-python",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pyodide-backed Python runtime for Warsha, implementing the app's Runtime contract",
  "main": "src/index.ts",
  "scripts": {
    "check": "node --check src/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:harness": "node build.mjs",
    "harness": "node build.mjs && node serve.mjs 8084"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}

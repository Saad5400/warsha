# Keep the build context lean and reproducible.
**/node_modules
**/dist
**/.cache
**/.git
**/*.log

# Generated build inputs — regenerated by app/'s `assets` prebuild step.
app/public/warsha-jvm.worker.js
app/public/ecj.jar
# The 66 MB C# engine bundle is published from source by runtimes/csharp/build.sh
# during the build; keeping it out of the context matches prod (gitignored there)
# and forces a clean publish instead of build.sh's staged-bundle shortcut.
app/public/warsha-dotnet/

# Not needed to build or serve the app.
tools/
.github/

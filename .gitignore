# Never commit compiler/runtime binaries — licensing (see docs/legal/THIRD-PARTY.md).
# Oracle JDK jars are NOT redistributable; use Temurin tools.jar or ecj, fetched at runtime.
*.jar

node_modules/
dist/

# QA evidence: regenerated by every run, never a source of truth.
tools/qa/screenshots/
screenshots/
tools/qa/crops/
tools/qa/crops-after/

# Harness bundles, produced by `node build.mjs` in each runtime package.
runtimes/*/harness/build/
# Manual harness screenshots — evidence, regenerate on demand.
runtimes/*/harness/screenshot-*.jpg

# Local scratch and OS/editor noise.
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.local
.env
.env.*
.idea/
.vscode/

# Warsha collab/sync server — environment.
#
# Legend:
#   [REQUIRED-in-prod]  loadEnv() REFUSES TO BOOT if this is missing when
#                       NODE_ENV=production (and rejects the dev/default value).
#   [optional]          has a safe default; tune as needed.
#
# In production set NODE_ENV=production (the Docker image already bakes this in).

# ---- Runtime mode ----
# NODE_ENV=production            # prod: dev bearer off, sensitive vars required, generic 5xx bodies.

# ---- HTTP server ----
HOST=0.0.0.0                      # [optional]
PORT=8787                         # [optional]
LOG_LEVEL=info                    # [optional]

# ---- Proxy / client IP ----
# [optional] How many proxy hops to trust for request.ip / X-Forwarded-For.
# Behind Traefik this MUST be correct or per-IP rate-limit buckets collapse to
# the proxy. Default: dev=false (socket peer is the client), prod=1 (Traefik).
# Values: 'true' (trust all hops — UNSAFE, lets clients spoof), 'false',
# a number of hops, or a comma-separated list of trusted proxy IPs/CIDRs.
# IMPORTANT: Traefik must be configured to OVERWRITE (not append) X-Forwarded-For.
#TRUST_PROXY=1

# ---- Auth: static dev bearer ----
# Dev-only backdoor bearer. Disabled automatically when NODE_ENV=production;
# the server REFUSES TO BOOT if it would be enabled in prod. When enabled,
# DEV_SHARED_SECRET is REQUIRED and must not be the placeholder below.
DEV_SHARED_SECRET=change-me-to-a-real-unique-secret   # [required when DEV_BEARER_ENABLED]
#DEV_BEARER_ENABLED=false

# ---- Sharing model ----
# [optional] Per-email ACL sharing (§7.2). Default OFF (and must stay off in prod
# until email verification lands — unverified emails allow account squatting,
# finding H2). Link-access + owner sharing are unaffected.
#ACCOUNT_EMAIL_SHARING_ENABLED=false

# ---- Rate limiting (@fastify/rate-limit) ----  [optional]
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute
# Hard limit specifically for POST /v1/devices (token minting).
DEVICE_RATE_LIMIT_MAX=5
DEVICE_RATE_LIMIT_WINDOW=1 hour
# Hard per-IP limit for POST /v1/auth/signup, /login and /claim-device.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# ---- Quotas (contract §7.3) ----  [optional]
QUOTA_DEVICE_DOCS=10
QUOTA_DEVICE_BYTES=26214400
QUOTA_ACCOUNT_DOCS=200
QUOTA_ACCOUNT_BYTES=262144000

# ---- Postgres (Drizzle) ----
# [REQUIRED-in-prod] The dev localhost value is rejected under NODE_ENV=production.
DATABASE_URL=postgres://warsha:warsha@localhost:5432/warsha

# ---- CORS (browser origins allowed to call this API) ----
# [REQUIRED-in-prod] Comma-separated. '*' (reflect-any) is rejected in production.
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083

# ---- Object storage (Hetzner S3-compatible; MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000     # [REQUIRED-in-prod] (localhost rejected in prod)
S3_REGION=us-east-1                   # [optional]
S3_BUCKET=warsha-docs                 # [REQUIRED-in-prod]
S3_ACCESS_KEY_ID=minioadmin           # [REQUIRED-in-prod] ('minioadmin' rejected in prod)
S3_SECRET_ACCESS_KEY=minioadmin       # [REQUIRED-in-prod] ('minioadmin' rejected in prod)
# MinIO and most non-AWS providers need path-style addressing.
S3_FORCE_PATH_STYLE=true              # [optional]

# ---- Snapshot body cap ----  [optional]
# 5 MB. PUT /v1/docs/:id larger than this returns 413.
MAX_SNAPSHOT_BYTES=5242880

# ---- ICE / WebRTC ----  [optional]
# JSON array served verbatim from GET /v1/ice. Defaults to a public STUN in dev.
# Real coturn (turns: on :443) is an infra/deploy task, not code.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
